# Base de Dados
# Produção e schema principal (Neon PostgreSQL):
DATABASE_URL="postgresql://username:password@ep-sample-neon.region.aws.neon.tech/neondb?sslmode=require"

# Desenvolvimento/backup SQLite: usar apenas com --schema prisma/schema.sqlite.prisma
# DATABASE_URL="file:./dev.db"

# Autenticação e Segurança (Gerar com `openssl rand -base64 32`)
AUTH_SECRET="sua-chave-secreta-jwt-com-pelo-menos-32-caracteres"
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_DEFAULT_PASSWORD="defina_uma_password_forte_aqui"

# URL do Website
NEXT_PUBLIC_SITE_URL="https://seu-portfolio.vercel.app"

# Vercel Blob Storage (Opcional para uploads persistentes na nuvem em produção)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_aqui"
