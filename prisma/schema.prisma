generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN") // ADMIN, EDITOR, VIEWER
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id               String         @id @default(cuid())
  slug             String         @unique
  number           String         // "01", "02", etc.
  title            String
  category         String         // "Habitacional", "Equipamento", "Urbano", "Reabilitação", "Interiores", "BIM & Técnico"
  location         String
  year             String         @default("2026")
  status           String         @default("Concluído")
  description      String
  area             String?
  role             String?
  software         String?
  services         String?
  concept          String?
  technicalDetails String?
  coverImage       String
  featured         Boolean        @default(false)
  published        Boolean        @default(true)
  order            Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  publishedAt      DateTime?      @default(now())
  media            ProjectMedia[]
}

model ProjectMedia {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  type      String   @default("IMAGE") // IMAGE, PLAN, SECTION, ELEVATION, RENDER, PHOTO
  alt       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Experience {
  id           String   @id @default(cuid())
  period       String
  role         String
  organization String
  description  String
  order        Int      @default(0)
  createdAt    DateTime @default(now())
}

model Education {
  id          String   @id @default(cuid())
  period      String
  degree      String
  institution String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Skill {
  id        String @id @default(cuid())
  name      String
  level     String // "Avançado", "Intermédio", "Ferramenta"
  category  String // "Modelagem & Desenho", "Renderização", "BIM & GIS"
  order     Int    @default(0)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String
  createdAt DateTime @default(now())
}

model SiteSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
